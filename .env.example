# =========================================================
# IAM Secure - Variables de entorno de ejemplo
# =========================================================
#
# Copie este archivo como .env antes de iniciar el entorno:
#
#   Copy-Item .env.example .env
#
# SEGURIDAD:
# - Este archivo contiene únicamente marcadores y valores de ejemplo.
# - No coloque secretos reales en .env.example.
# - El archivo .env real no debe almacenarse en Git.
# - Cambie credenciales y secretos antes de utilizar el proyecto
#   fuera de un entorno local de demostración.
# =========================================================


# =========================================================
# POSTGRESQL
# =========================================================

POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LOCAL


# =========================================================
# DATOS DE DEMOSTRACIÓN
# =========================================================
# Se conserva para los scripts académicos que puedan utilizar
# una credencial de demostración desde el entorno.
# Nunca coloque aquí la contraseña real.
# =========================================================

DEMO_IDENTITY_PASSWORD=CAMBIAR_PASSWORD_DEMO


# =========================================================
# JWT
# =========================================================

JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ------------------------------------------------------
# MFA / TOTP
# ------------------------------------------------------
# El bootstrap importa componentes de autenticación.
# Por ello también recibe la clave Fernet utilizada por
# el subsistema MFA. El valor real permanece únicamente
# en el archivo .env local.

MFA_ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_FERNET_GENERADA_LOCALMENTE

# =========================================================
# POLÍTICA DE CONTRASEÑAS
# =========================================================

TEMP_PASSWORD_EXPIRE_HOURS=24
PASSWORD_EXPIRE_DAYS=60


# =========================================================
# RECUPERACIÓN DE CONTRASEÑA
# =========================================================

PASSWORD_RECOVERY_COOLDOWN_MINUTES=15


# =========================================================
# SESIONES
# =========================================================

SESSION_INACTIVITY_MINUTES=5


# =========================================================
# CORS - FRONTENDS AUTORIZADOS
# =========================================================
# main.py utiliza esta lista para permitir únicamente los
# orígenes autorizados del frontend.
#
# Desarrollo local:
#   http://localhost:5173
#   http://127.0.0.1:5173
#
# Para acceder desde otro computador de la misma red, agregue
# también el origen real del equipo que ejecuta IAM Secure:
#
#   http://IP_DEL_EQUIPO:5173
#
# Los valores se separan por comas y NO se recomienda usar "*".
# =========================================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# =========================================================
# FRONTEND - VITE
# =========================================================
# App.jsx puede determinar automáticamente el hostname desde
# el que se abrió la aplicación y utilizar el puerto 8003.
#
# VITE_API_URL es opcional. Déjela vacía para utilizar ese
# comportamiento automático. Si se define, debe apuntar al
# Identity Service accesible desde el navegador.
#
# Ejemplo para otro computador:
#   VITE_API_URL=http://IP_DEL_EQUIPO:8003
#
# El valor de inactividad debe mantenerse alineado con
# SESSION_INACTIVITY_MINUTES.
# =========================================================

VITE_API_URL=
VITE_SESSION_INACTIVITY_MINUTES=5


# =========================================================
# SMTP
# =========================================================
# SMTP_PASSWORD debe contener el secreto únicamente dentro
# del archivo .env real.
# =========================================================

SMTP_HOST=CAMBIAR_HOST_SMTP
SMTP_PORT=587
SMTP_USER=CAMBIAR_USUARIO_SMTP
SMTP_PASSWORD=CAMBIAR_PASSWORD_SMTP
SMTP_FROM=CAMBIAR_REMITENTE_SMTP


# =========================================================
# BOOTSTRAP INICIAL ADMIN_TI
# =========================================================
# Definir únicamente cuando se ejecute manualmente
# bootstrap_admin_ti.py.
#
# Este valor es solo un marcador de ejemplo. La contraseña
# real debe existir únicamente en el entorno seguro utilizado
# para ejecutar el bootstrap.
# =========================================================

BOOTSTRAP_ADMIN_TI_PASSWORD=CAMBIAR_PASSWORD_TEMPORAL_ADMIN_TI

# ============================================================
# SYNC WORKER
# ============================================================
# Intervalos y tiempos de procesamiento del Worker asíncrono.
# No contienen secretos.
SYNC_POLL_SECONDS=5
SYNC_RETRY_DELAY_SECONDS=15
SYNC_JOB_TIMEOUT_SECONDS=300
SYNC_RECOVERY_CHECK_SECONDS=60
SYNC_SIMULATED_PROCESS_SECONDS=2

# =========================================================
# AUDIT SERVICE
# =========================================================
# Token utilizado exclusivamente para autenticación interna
# entre los microservicios y Audit Service.
#
# El valor real debe existir únicamente en .env.
# Utilizar como mínimo 32 caracteres aleatorios.
# =========================================================

AUDIT_INTERNAL_TOKEN=CAMBIAR

# =========================================================
# IDENTITY -> AUDIT SERVICE
# =========================================================
# Dirección interna utilizada por Identity Service.
# El token es compartido exclusivamente entre servicios.
# =========================================================

AUDIT_SERVICE_URL=http://audit-service:8004
AUDIT_HTTP_TIMEOUT_SECONDS=2

# =========================================================
# AUDIT DISPATCHER
# =========================================================
# Worker encargado de entregar los eventos persistidos en
# auditoria_outbox hacia Audit Service.
# =========================================================

AUDIT_DISPATCH_POLL_SECONDS=2
AUDIT_DISPATCH_RETRY_DELAY_SECONDS=15
AUDIT_DISPATCH_MAX_ATTEMPTS=5
AUDIT_DISPATCH_JOB_TIMEOUT_SECONDS=120
AUDIT_DISPATCH_RECOVERY_CHECK_SECONDS=30
