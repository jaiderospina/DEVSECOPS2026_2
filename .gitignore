# =========================================================
# IAM Secure - .gitignore
# =========================================================

# ---------------------------------------------------------
# Variables de entorno y secretos
# ---------------------------------------------------------
.env
**/.env
.env.*
**/.env.*

# Los archivos de ejemplo SÍ deben versionarse
!.env.example
!**/.env.example

# ---------------------------------------------------------
# Credenciales, certificados y claves privadas
# ---------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer

# ---------------------------------------------------------
# Python - entornos virtuales
# ---------------------------------------------------------
venv/
**/venv/
.venv/
**/.venv/

# ---------------------------------------------------------
# Python - caché, pruebas y archivos generados
# ---------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
coverage.xml
htmlcov/
**/htmlcov/
*.egg-info/
**/*.egg-info/
build/
**/build/

# ---------------------------------------------------------
# Node.js / React / Vite
# ---------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# Backups y archivos temporales
# ---------------------------------------------------------
backups/
**/backups/
*.backup
*.backup.*
*.bak
*.tmp
*.temp
*.swp
*~

# ---------------------------------------------------------
# IDE / Editores
# ---------------------------------------------------------
.vscode/
.idea/

# ---------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------
# Logs locales
# ---------------------------------------------------------
*.log
logs/
**/logs/

# ---------------------------------------------------------
# Bases de datos locales / artefactos de desarrollo
# ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------
# Proyecto anterior OpenTrace / ShadowPulse
# ---------------------------------------------------------
opentrace/
servicios/worker-alerts/
servicios/worker-recon/

# ---------------------------------------------------------
# Copias auxiliares locales del desarrollo
# ---------------------------------------------------------
App_actual.jsx
App_css_actual.txt
autenticacion_actual.py
autenticacion_actual.txt
companias_actual.py

# ---------------------------------------------------------
# Respaldos históricos internos de Identity Service
# ---------------------------------------------------------
servicios/identity-service/*_antes_*.py
servicios/identity-service/*_backup*.py
servicios/identity-service/*.py.bak

# Configuración generada durante la compilación del frontend
servicios/frontend/nginx.conf

# Ephemeral DAST runtime: keep secrets and raw evidence out of Git
/dast-runtime/
/dast/runtime/
zap.env

# Disposable CI test and coverage reports
/reports/
/coverage-input/
.coverage.*

# Private TLS/runtime credentials and encrypted workstation backups.
/.private/
/backups/
