{
  "services": {
    "postgres": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "512m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777",
        "/var/run/postgresql:rw,noexec,nosuid,size=16m,mode=3775,uid=999,gid=999"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "postgres:17@sha256:ae69c452f483507a6b99fb654cf93aad7fe156ffd2c56247707eef4e36d3c12b",
      "user": "postgres",
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "iam_secure",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?required}"
      },
      "volumes": [
        "postgres_data:/var/lib/postgresql/data",
        "./postgres-init:/docker-entrypoint-initdb.d:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 30,
        "start_period": "10s"
      },
      "networks": [
        "data"
      ],
      "group_add": [
        "${IAM_SQL_READ_GID:?required}"
      ]
    },
    "identity": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "jeancarlosalmenarez8318/iam-secure-identity:1.0.0@sha256:839ce22bfbf6a50396fc75a77a691750b0bce9ce99e00d9b6c222d12492e750b",
      "environment": {
        "DB_USER": "postgres",
        "DB_PASSWORD": "${POSTGRES_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "JWT_SECRET": "${JWT_SECRET:?required}",
        "JWT_ALGORITHM": "HS256",
        "JWT_EXPIRE_MINUTES": "30",
        "MFA_ENCRYPTION_KEY": "${MFA_ENCRYPTION_KEY:?required}",
        "TEMP_PASSWORD_EXPIRE_HOURS": "24",
        "PASSWORD_EXPIRE_DAYS": "60",
        "PASSWORD_RECOVERY_COOLDOWN_MINUTES": "15",
        "SESSION_INACTIVITY_MINUTES": "5",
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176",
        "SMTP_HOST": "${SMTP_HOST:-smtp.example.invalid}",
        "SMTP_PORT": "${SMTP_PORT:-587}",
        "SMTP_USER": "${SMTP_USER:-}",
        "SMTP_PASSWORD": "${SMTP_PASSWORD:-}",
        "SMTP_FROM": "${SMTP_FROM:-iam@example.invalid}"
      },
      "ports": [
        "127.0.0.1:8003:8003"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8003/', timeout=3)"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24,
        "start_period": "10s"
      },
      "networks": [
        "data",
        "edge"
      ]
    },
    "permissions": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
