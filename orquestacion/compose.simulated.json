      },
      "image": "jeancarlosalmenarez8318/iam-secure-permissions:1.0.0@sha256:b80cf3ad35ce6a7502570924930e8592d2afd3a42ad07879a61be6475edfccda",
      "environment": {
        "DB_USER": "postgres",
        "DB_PASSWORD": "${POSTGRES_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "IAM_BASE_URL": "http://identity:8003",
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176"
      },
      "ports": [
        "127.0.0.1:8005:8005"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "identity": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8005/', timeout=3)"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24,
