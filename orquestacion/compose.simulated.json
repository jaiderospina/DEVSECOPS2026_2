        "SMTP_PASSWORD": "${SMTP_PASSWORD:-}",
        "SMTP_FROM": "${SMTP_FROM:-iam@example.invalid}",
        "BOOTSTRAP_ADMIN_TI_PASSWORD": "${BOOTSTRAP_ADMIN_TI_PASSWORD:-}"
      },
