{
  "services": {
    "postgres": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "512m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777",
        "/var/run/postgresql:rw,noexec,nosuid,size=16m,mode=3775,uid=999,gid=999"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "postgres:17@sha256:ae69c452f483507a6b99fb654cf93aad7fe156ffd2c56247707eef4e36d3c12b",
      "user": "postgres",
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "iam_secure",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?required}"
      },
      "volumes": [
        "secure_lab_data:/var/lib/postgresql/data",
        "./postgres-init:/docker-entrypoint-initdb.d:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 30,
        "start_period": "10s"
      },
      "networks": [
        "data"
      ]
    },
    "identity": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "environment": {
        "DB_USER": "iam_identity",
        "DB_PASSWORD": "${IDENTITY_DB_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "JWT_SECRET": "${JWT_SECRET:?required}",
        "JWT_ALGORITHM": "HS256",
        "JWT_EXPIRE_MINUTES": "30",
        "MFA_ENCRYPTION_KEY": "${MFA_ENCRYPTION_KEY:?required}",
        "TEMP_PASSWORD_EXPIRE_HOURS": "24",
        "PASSWORD_EXPIRE_DAYS": "60",
        "PASSWORD_RECOVERY_COOLDOWN_MINUTES": "15",
        "SESSION_INACTIVITY_MINUTES": "5",
        "CORS_ORIGINS": "https://localhost:8443,https://localhost:8444",
        "SMTP_HOST": "smtp.example.invalid",
        "SMTP_PORT": "${SMTP_PORT:-587}",
        "SMTP_USER": "",
        "SMTP_PASSWORD": "",
        "SMTP_FROM": "iam@example.invalid"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8003/', timeout=3)"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24,
        "start_period": "10s"
      },
      "networks": [
        "data",
        "api"
      ],
      "build": {
        "context": "./servicios/identity-service"
      }
    },
    "permissions": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "environment": {
        "DB_USER": "iam_permissions",
        "DB_PASSWORD": "${PERMISSIONS_DB_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "IAM_BASE_URL": "http://identity:8003",
        "CORS_ORIGINS": "https://localhost:8443,https://localhost:8444"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "identity": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8005/', timeout=3)"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24,
        "start_period": "10s"
      },
      "networks": [
        "data",
        "api"
      ],
      "build": {
        "context": "./servicios/permissions-service"
      }
    },
    "audit-service": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "environment": {
        "DB_USER": "iam_audit",
        "DB_PASSWORD": "${AUDIT_DB_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "AUDIT_INTERNAL_TOKEN": "${AUDIT_INTERNAL_TOKEN:?required}"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8004/health', timeout=3)"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24,
        "start_period": "10s"
      },
      "networks": [
        "data",
        "api"
      ],
      "build": {
        "context": "./servicios/audit-service"
      }
    },
    "sync-worker": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "environment": {
        "DB_USER": "iam_sync",
        "DB_PASSWORD": "${SYNC_DB_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "SYNC_POLL_SECONDS": "5",
        "SYNC_RETRY_DELAY_SECONDS": "15",
        "SYNC_JOB_TIMEOUT_SECONDS": "300",
        "SYNC_RECOVERY_CHECK_SECONDS": "60",
        "SYNC_SIMULATED_PROCESS_SECONDS": "2"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "stop_grace_period": "15s",
      "networks": [
        "data"
      ],
      "build": {
        "context": "./servicios/sync-service"
      }
    },
    "audit-dispatcher": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "environment": {
        "DB_USER": "iam_dispatcher",
        "DB_PASSWORD": "${DISPATCHER_DB_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "AUDIT_SERVICE_URL": "http://audit-service:8004",
        "AUDIT_INTERNAL_TOKEN": "${AUDIT_INTERNAL_TOKEN:?required}",
        "AUDIT_HTTP_TIMEOUT_SECONDS": "3",
        "AUDIT_DISPATCH_POLL_SECONDS": "2",
        "AUDIT_DISPATCH_RETRY_DELAY_SECONDS": "15",
        "AUDIT_DISPATCH_MAX_ATTEMPTS": "5",
        "AUDIT_DISPATCH_JOB_TIMEOUT_SECONDS": "120",
        "AUDIT_DISPATCH_RECOVERY_CHECK_SECONDS": "30"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "audit-service": {
          "condition": "service_healthy"
        }
      },
      "stop_grace_period": "15s",
      "networks": [
        "data",
        "api"
      ],
      "build": {
        "context": "./servicios/audit-dispatcher"
      }
    },
    "frontend": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:5173/"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24
      },
      "depends_on": {
        "identity": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "edge"
      ],
      "build": {
        "context": "./servicios/frontend",
        "args": {
          "VITE_API_URL": "https://localhost:8445",
          "VITE_PERMISSIONS_API_URL": "https://localhost:8446",
          "VITE_PORTAL_ORIGIN": "https://localhost:8443",
          "VITE_PERMISSIONS_GRID_ORIGIN": "https://localhost:8444"
        }
      }
    },
    "permissions-grid": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "unless-stopped",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:5173/"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 24
      },
      "depends_on": {
        "permissions": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "edge"
      ],
      "build": {
        "context": "./servicios/frontend",
        "args": {
          "VITE_API_URL": "https://localhost:8445",
          "VITE_PERMISSIONS_API_URL": "https://localhost:8446",
          "VITE_PORTAL_ORIGIN": "https://localhost:8443",
          "VITE_PERMISSIONS_GRID_ORIGIN": "https://localhost:8444"
        }
      }
    },
    "bootstrap-admin": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "256m",
      "restart": "no",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "profiles": [
        "bootstrap"
      ],
      "environment": {
        "DB_USER": "iam_identity",
        "DB_PASSWORD": "${IDENTITY_DB_PASSWORD:?required}",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "iam_secure",
        "JWT_SECRET": "${JWT_SECRET:?required}",
        "JWT_ALGORITHM": "HS256",
        "JWT_EXPIRE_MINUTES": "30",
        "MFA_ENCRYPTION_KEY": "${MFA_ENCRYPTION_KEY:?required}",
        "TEMP_PASSWORD_EXPIRE_HOURS": "24",
        "PASSWORD_EXPIRE_DAYS": "60",
        "PASSWORD_RECOVERY_COOLDOWN_MINUTES": "15",
        "SESSION_INACTIVITY_MINUTES": "5",
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176",
        "SMTP_HOST": "${SMTP_HOST:-smtp.example.invalid}",
        "SMTP_PORT": "${SMTP_PORT:-587}",
        "SMTP_USER": "${SMTP_USER:-}",
        "SMTP_PASSWORD": "${SMTP_PASSWORD:-}",
        "SMTP_FROM": "${SMTP_FROM:-iam@example.invalid}",
        "BOOTSTRAP_ADMIN_TI_PASSWORD": "${BOOTSTRAP_ADMIN_TI_PASSWORD:-}"
      },
      "command": [
        "python",
        "bootstrap_admin_ti.py"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "data"
      ],
      "build": {
        "context": "./servicios/identity-service"
      }
    },
    "gateway": {
      "build": {
        "context": "./infraestructura/tls"
      },
      "user": "${GATEWAY_UID:?required}:${GATEWAY_GID:?required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "pids_limit": 128,
      "mem_limit": "128m",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=32m,mode=1777"
      ],
      "restart": "unless-stopped",
      "volumes": [
        "${IAM_LAB_PRIVATE_DIR:?required}/server.pem:/run/tls/server.pem:ro",
        "${IAM_LAB_PRIVATE_DIR:?required}/server.key:/run/tls/server.key:ro",
        "${IAM_LAB_PRIVATE_DIR:?required}/server.pass:/run/tls/server.pass:ro"
      ],
      "ports": [
        "127.0.0.1:8443:8443",
        "127.0.0.1:8444:8444",
        "127.0.0.1:8445:8445",
        "127.0.0.1:8446:8446"
      ],
      "networks": [
        "edge",
        "api"
      ],
      "depends_on": [
        "frontend",
        "permissions-grid",
        "identity",
        "permissions"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "data": {
      "internal": true
    },
    "api": {
      "internal": true
    },
    "edge": {}
  },
  "volumes": {
    "secure_lab_data": {}
  }
}
